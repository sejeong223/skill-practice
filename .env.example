# Public Entra application IDs only. Copy to .env.local; never put a client secret here.
NEXT_PUBLIC_GAME_TENANT_ID=
NEXT_PUBLIC_GAME_WEB_CLIENT_ID=
NEXT_PUBLIC_GAME_API_CLIENT_ID=
# Registered SPA root URI, e.g. http://localhost:3000/ or https://<site>.azurestaticapps.net/
# Also register <same-origin>/auth/redirect/ for MSAL 5 silent token renewal.
NEXT_PUBLIC_GAME_REDIRECT_URI=
# cloud by default. local-dev works only with npm run dev, never a production build.
NEXT_PUBLIC_GAME_MODE=cloud
