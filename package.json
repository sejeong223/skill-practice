{
  "name": "skill-practice",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "serve out -l 3000 --no-clipboard",
    "build:release": "node scripts/build-game-release.mjs",
    "check:release": "node scripts/check-game-release.mjs",
    "test:release-config": "node --test scripts/release-config.test.mjs",
    "test:workflow": "node --test scripts/game-workflow.test.mjs",
    "test:cloud": "node --import tsx --test scripts/cloud-contracts.test.mjs scripts/api-auth.test.mjs scripts/api-session.test.mjs scripts/api-save.test.mjs scripts/api-ranking.test.mjs scripts/cloud-auth.test.mjs scripts/cloud-save-client.test.mjs scripts/cloud-resume.test.mjs scripts/cloud-game.test.mjs scripts/ranking-ui.test.mjs scripts/development-start.test.mjs",
    "lint": "eslint",
    "test:progression": "node --experimental-strip-types --test scripts/stage-progression.test.mjs",
    "test:cloud-contracts": "node --import tsx --test scripts/cloud-contracts.test.mjs",
    "build:api": "node scripts/build-game-api.mjs",
    "typecheck:api": "tsc -p api/tsconfig.json",
    "test:api-auth": "node --import tsx --test scripts/api-auth.test.mjs",
    "test:api-session": "node --import tsx --test scripts/api-session.test.mjs",
    "test:api-save": "node --import tsx --test scripts/api-save.test.mjs",
    "test:api-ranking": "node --import tsx --test scripts/api-ranking.test.mjs",
    "test:cloud-auth": "node --import tsx --test scripts/cloud-auth.test.mjs",
    "test:cloud-save-client": "node --import tsx --test scripts/cloud-save-client.test.mjs",
    "test:cloud-resume": "node --import tsx --test scripts/cloud-resume.test.mjs",
    "world01:maps": "node scripts/world01-maps.mjs",
    "world01:maps:check": "node scripts/world01-maps.mjs --check",
    "test:cloud-game": "node --import tsx --test scripts/cloud-game.test.mjs",
    "test:ranking-ui": "node --import tsx --test scripts/ranking-ui.test.mjs"
  },
  "overrides": {
    "serve": {
      "compression": "1.8.2"
    }
  },
  "dependencies": {
    "@azure/msal-browser": "^5.27.0",
    "next": "16.4.5",
    "phaser": "^3.90.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "jsdom": "^30.1.3",
    "serve": "14.2.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "yaml": "2.9.1"
  }
}
